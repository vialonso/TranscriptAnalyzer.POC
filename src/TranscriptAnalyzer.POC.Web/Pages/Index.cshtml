@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <h2>Upload PDF Transcript</h2>
    <form id="uploadForm" enctype="multipart/form-data" method="post">
        <div id="drop-area" style="border: 2px dashed #ccc; padding: 40px; text-align: center;">
            <p>Drag & drop a PDF file here or click to select</p>
            <input type="file" id="fileInput" name="pdfFile" accept="application/pdf" style="display:none;" />
            <button type="button" onclick="document.getElementById('fileInput').click();">Choose File</button>
            <div id="fileName"></div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Submit</button>
    </form>

    @if (Model.PdfUrl != null)
    {
        <div class="mt-4">
            <h4>PDF Preview</h4>
            <iframe src="@Model.PdfUrl" width="100%" height="800px" style="border:1px solid #ccc;"></iframe>
        </div>
    }

    <hr />

    @if (Model.TranscriptCourses.Count > 0)
    {
        <h3>Transcript Data</h3>
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Title</th>
                    <th>Code</th>
                    <th>Credits</th>
                    <th>Grade</th>
                    <th>Calendar System</th>
                </tr>
            </thead>
            <tbody>

                @{
                    // Loop through the transcript courses and display them
                    foreach (var course in Model.TranscriptCourses)
                    {
                        <tr>
                            <td>@course.Month</td>
                            <td>@course.Year</td>
                            <td>@course.Title</td>
                            <td>@course.Code</td>
                            <td>@course.Credits</td>
                            <td>@course.Grade</td>
                            <td>@course.CalendarSystem</td>
                        </tr>
                    }
                }                
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        const dropArea = document.getElementById('drop-area');
        const fileInput = document.getElementById('fileInput');
        const fileNameDiv = document.getElementById('fileName');

        dropArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropArea.style.background = '#f0f0f0';
        });

        dropArea.addEventListener('dragleave', (e) => {
            e.preventDefault();
            dropArea.style.background = '';
        });

        dropArea.addEventListener('drop', (e) => {
            e.preventDefault();
            dropArea.style.background = '';
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                fileNameDiv.textContent = e.dataTransfer.files[0].name;
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (fileInput.files.length) {
                fileNameDiv.textContent = fileInput.files[0].name;
            }
        });
    </script>
}
